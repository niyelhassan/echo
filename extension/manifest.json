{
  "manifest_version": 3,
  "name": "Tone Caption \u2014 Local",
  "version": "0.3.0",
  "description": "Private, on-device live captions for any tab, with sound cues like [laughter] and tentative vocal-tone labels.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tone Caption"
  },
  "commands": {
    "toggle-captions": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Start or stop captions on this tab"
    },
    "toggle-transcript": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Show or hide the transcript"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:8765"
  }
}